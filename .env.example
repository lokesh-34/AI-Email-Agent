# ============================================================
# AI Email Copilot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Groq API Key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net

# Google OAuth (Web Application credentials)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
MOBILE_REDIRECT_URI=com.lokesh.aiemailagent://auth/callback

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY_HOURS=24

# Optional MongoDB settings
# MONGODB_DATABASE=academic_agent
# MONGODB_TASK_COLLECTION=tasks
# MONGODB_DRAFT_COLLECTION=email_drafts
